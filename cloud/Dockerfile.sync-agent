# Un conteneur léger par Fog : pas de base de données, seulement le client HTTP.
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY fog_sync_agent.py /app/fog_sync_agent.py
# Exécution sans privilèges root.
USER 65532:65532
ENTRYPOINT ["python", "-u", "/app/fog_sync_agent.py"]
